<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="org.yourorg.csvdownload" extension-version="1.0.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>One-click CSV download of a single worksheet, laid out like the dashboard table.</description>
    <author name="Your Name" email="you@yourorg.org" organization="Your Org" website="https://yourorg.org"/>
    <min-api-version>1.10</min-api-version>
    <source-location>
      <!-- Must be HTTPS (http://localhost is allowed for testing in Tableau Desktop). -->
      <url>https://YOUR-HOST/csv-export/index.html</url>
    </source-location>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Download CSV</text>
    </resource>
  </resources>
</manifest>
