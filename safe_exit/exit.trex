<?xml version="1.0" encoding="utf-8"?>
<manifest manifest-version="0.1" xmlns="http://www.tableau.com/xml/extension_manifest">
  <dashboard-extension id="com.example.extensions.dvexit" extension-version="0.1.0">
    <default-locale>en_US</default-locale>
    <name resource-id="name"/>
    <description>Quick exit button</description>
    <author name="Dashboard Team" email="team@example.com" organization="Organization" website="https://www.example.com"/>
    <min-api-version>1.0</min-api-version>
    <source-location>
      <url>https://USERNAME.github.io/exit.html</url>
    </source-location>
    <icon>
    
    </icon>
  </dashboard-extension>
  <resources>
    <resource id="name">
      <text locale="en_US">Quick Exit</text>
    </resource>
  </resources>
</manifest>
